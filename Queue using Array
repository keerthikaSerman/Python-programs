queue = [None] * 5
front = -1
rear = -1
MAX_SIZE = 5
def enqueue(x):
    global front, rear
    if rear == MAX_SIZE - 1:
        print("\nCar Parking is Full!")
    else:
        if front == -1:
            front = 0
        rear += 1
        queue[rear] = x
        print(f"\nCar Parked Successfully: {x}")

def dequeue():
    global front, rear
    if front == -1 or front > rear:
        print("\nCar Parking is Empty!")
    else:
        print(f"\nCar Moved Successfully: {queue[front]}")
        front += 1
        if front > rear:
            front = -1
            rear = -1

def display():
    if front == -1 or front > rear:
        print("\nCurrent Car Parking Status: Empty")
    else:
        print(f"\nCurrent Car Parking Queue: {queue[front:rear+1]}")



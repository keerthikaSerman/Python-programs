def procedence(operator):
    if operator in ("+","-"):
        return 1
    elif operator in ("*","/"):
        return 2
    elif operator == "^":
        return 3
    return 0
bracket={")":"(","]":"[","}":"{"}

def infix_to_postfix(expression):
    stack=[]
    postfix=" "
    for char in expression:
        if char.isalnum():
            postfix+=char
        elif char in "([{":
            stack.append(char)
        elif char in ")]}":
            matching=bracket
            while stack and stack[-1] != matching:
                postfix += stack.pop()
            if stack:
                stack.pop()
        else:
            while(stack and stack[-1] not in "([{" and procedence(stack[-1]) >= procedence(char)):
                postfix+=stack.pop()
            stack.append(char)
    while stack:
        postfix += stack.pop()
    return postfix
infix=input("Enter the infix expression:")
postfix=infix_to_postfix(infix)
print("Postfix expression:",postfix)
   
